---
/**
 * HexGrid.astro
 * A component for arranging hexagonal elements in a honeycomb pattern
 */

interface Props {
    /**
     * Optional CSS class to add to the container
     */
    class?: string;

    /**
     * Optional ID for the container
     */
    id?: string;

    /**
     * Start a new row for each year (from the hexagons' data-year) instead of balancing rows
     */
    groupByYear?: boolean;
}

const { class: className = "", id, groupByYear = false } = Astro.props;
---

<div
    class:list={["hex-grid-container", className]}
    id={id}
    data-group-by-year={groupByYear ? "" : undefined}
    aria-label="Grid of hexagonal stickers"
>
    <slot />
</div>

<style>
    /* Styles for the hex grid container */
    .hex-grid-container {
        position: relative;
        width: 100%;
        transition: height 0.4s ease-out;

        /* Bootstrap-compatible responsive margins */
        --bs-gutter-x: 1.5rem;
        --bs-gutter-y: 0;
        padding-right: calc(var(--bs-gutter-x) * 0.5);
        padding-left: calc(var(--bs-gutter-x) * 0.5);
        margin-right: auto;
        margin-left: auto;
    }

    /* Responsive adjustments using Bootstrap 5.3 breakpoints */
    @media (min-width: 576px) {
        .hex-grid-container {
            max-width: 540px;
        }
    }

    @media (min-width: 768px) {
        .hex-grid-container {
            max-width: 720px;
        }
    }

    @media (min-width: 992px) {
        .hex-grid-container {
            max-width: 960px;
        }
    }

    @media (min-width: 1200px) {
        .hex-grid-container {
            max-width: 1140px;
        }
    }

    @media (min-width: 1400px) {
        .hex-grid-container {
            max-width: 1320px;
        }
    }
</style>

<script>
    /**
     * Arranges hexagonal elements in a honeycomb pattern: centred rows alternating
     * between `perRow` and `perRow - 1` hexagons.
     * @param {HTMLElement} container - The container element
     * @param {HTMLElement[]} hexElements - Array of hexagon elements
     * @param {Object} options - Configuration options
     */
    function arrangeHexGrid(container, hexElements, options = {}) {
        const { spacing = 4, maxPerRow = 6, transitionDuration = "0.4s", groupByYear = false } = options;
        if (!container || !hexElements || hexElements.length === 0) return;

        const rect = hexElements[0].getBoundingClientRect();
        const hexWidth = rect.width + spacing;
        const hexHeight = rect.height + spacing;
        const containerWidth = container.clientWidth;
        const isMobile = containerWidth < 576;

        const fits = Math.floor(containerWidth / hexWidth);
        const total = hexElements.length;
        const widest = Math.max(2, Math.min(isMobile ? 2 : fits, maxPerRow));
        const rowStep = hexHeight - hexHeight * (isMobile ? 0.15 : 0.25);

        const layout = (n, shortFirst) => {
            const rows = [];
            for (let i = 0, r = 0; i < total; r++) {
                const expected = (r % 2 === 0) !== shortFirst ? n : n - 1;
                const count = Math.min(expected, total - i);
                rows.push({ start: i, count });
                i += count;
            }
            return rows;
        };
        const spread = (rows) => Math.max(...rows.map((r) => r.count)) - Math.min(...rows.map((r) => r.count));

        // Fewest rows first, then the most evenly filled rows (honeycomb rows alternate n / n-1, either first)
        let rows = [{ start: 0, count: total }];
        if (groupByYear) {
            rows = [];
            for (let i = 0; i < total;) {
                let end = i;
                while (end < total && hexElements[end].dataset.year === hexElements[i].dataset.year) end++;
                for (let j = i; j < end; j += widest) rows.push({ start: j, count: Math.min(widest, end - j) });
                i = end;
            }
        } else if (total > widest) {
            const candidates = [];
            for (let n = 2; n <= widest; n++) candidates.push(layout(n, false), layout(n, true));
            rows = candidates.reduce((best, c) =>
                c.length < best.length || (c.length === best.length && spread(c) < spread(best)) ? c : best,
            );
        }

        container.style.position = "relative";
        container.style.height = `${(rows.length - 1) * rowStep + hexHeight}px`;

        requestAnimationFrame(() => {
            // Rows interlock only if each is offset half a hexagon from the one above; centred rows whose
            // counts differ by an even number aren't, so those toggle a half-hexagon nudge
            let nudge = 0;
            rows.forEach(({ start, count }, r) => {
                if (r > 0 && (rows[r - 1].count - count) % 2 === 0) nudge = nudge ? 0 : hexWidth / 2;
                const offsetX = (containerWidth - count * hexWidth) / 2 + nudge;
                for (let c = 0; c < count; c++) {
                    const hex = hexElements[start + c];
                    hex.style.transition = `left ${transitionDuration} ease-out, top ${transitionDuration} ease-out`;
                    hex.style.position = "absolute";
                    hex.style.left = `${offsetX + c * hexWidth}px`;
                    hex.style.top = `${r * rowStep}px`;
                    hex.setAttribute("data-row", r.toString());
                    hex.setAttribute("data-col", c.toString());
                }
            });
        });
    }

    /**
     * Sets up resize handling for the hex grid
     * @param {HTMLElement} container - The container element
     * @param {HTMLElement[]} hexElements - Array of hexagon elements
     * @param {Object} options - Configuration options
     * @returns {Function} Cleanup function to remove event listeners
     */
    function setupHexGridResizing(container, hexElements, options = {}) {
        let resizeTimeout;
        let lastWidth = window.innerWidth;
        let lastHeight = window.innerHeight;
        let ticking = false;

        // Throttled resize handler
        function handleResize() {
            // Only process if dimensions actually changed significantly (at least 20px)
            const currentWidth = window.innerWidth;
            const currentHeight = window.innerHeight;

            const widthChanged = Math.abs(currentWidth - lastWidth) > 20;
            const heightChanged = Math.abs(currentHeight - lastHeight) > 20;

            if (!widthChanged && !heightChanged) return;

            lastWidth = currentWidth;
            lastHeight = currentHeight;

            // Clear any existing timeout
            clearTimeout(resizeTimeout);

            // Don't schedule multiple rAF callbacks
            if (!ticking) {
                ticking = true;

                // Use requestAnimationFrame for better performance
                requestAnimationFrame(() => {
                    // Set a timeout to avoid too frequent updates
                    resizeTimeout = setTimeout(() => {
                        arrangeHexGrid(container, hexElements, options);
                        ticking = false;
                    }, 150); // Longer delay for smoother experience
                });
            }
        }

        // Debounced version for final layout after resize ends
        function handleResizeEnd() {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                arrangeHexGrid(container, hexElements, options);
            }, 250);
        }

        // Listen for both window resize and orientation change for mobile
        window.addEventListener("resize", handleResize, { passive: true });
        window.addEventListener("resize", handleResizeEnd, { passive: true });
        window.addEventListener("orientationchange", handleResizeEnd);

        // Initial arrangement
        arrangeHexGrid(container, hexElements, options);

        // Return cleanup function
        return () => {
            window.removeEventListener("resize", handleResize);
            window.removeEventListener("resize", handleResizeEnd);
            window.removeEventListener("orientationchange", handleResizeEnd);
        };
    }

    // Initialize any hex grids on the page
    document.addEventListener("DOMContentLoaded", () => {
        const hexGrids = document.querySelectorAll(".hex-grid-container");
        hexGrids.forEach((grid) => {
            const hexElements = Array.from(grid.querySelectorAll(".hex-container"));
            if (hexElements.length > 0) {
                setupHexGridResizing(grid, hexElements, { groupByYear: "groupByYear" in grid.dataset });
            }
        });
    });
</script>
