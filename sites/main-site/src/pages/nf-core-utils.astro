---
import MarkdownTocLayout from "@layouts/MarkdownTocLayout.astro";
import { Markdown } from "@mashehu/astropub-md";
import GithubSlugger from "github-slugger";

const title = "nf-core-utils";
const subtitle = "Nextflow plugin with nf-core utility functions";
const repo_url = "https://github.com/nf-core/nf-core-utils";
const docs_blob_url = `${repo_url}/blob/main/docs/`;

const raw_url = "https://raw.githubusercontent.com/nf-core/nf-core-utils/refs/heads/main/docs/";

// start from the guide and follow its links to the docs of the extensions and utilities,
// the other files in docs/ are for the developers of the plugin
const entry = "NfCoreUtilities.md";
const docs: { file: string; content: string }[] = [];
const queue = [entry];
while (queue.length) {
    const file = queue.shift()!;
    if (docs.some((d) => d.file === file)) {
        continue;
    }
    const content = await fetch(raw_url + file)
        .then((res) => (res.ok ? res.text() : Promise.reject(`Failed to fetch: ${res.status}`)))
        .catch(() => (file === entry ? "# Error loading content\n\nUnable to load documentation from GitHub." : null));
    // a broken link keeps pointing to GitHub
    if (content === null) {
        continue;
    }
    docs.push({ file, content });
    for (const [, link] of content
        .replace(/^ *(```|~~~)[\s\S]*?^ *\1/gm, "")
        .matchAll(/\]\(([^)\s#]+\.md)(#[^)\s]*)?\)/g)) {
        const path = new URL(link, raw_url + file).href;
        if (path.startsWith(raw_url)) {
            queue.push(path.slice(raw_url.length));
        }
    }
}
// docs at the top of docs/ first, then those of each subfolder
docs.sort((a, b) => Number(a.file.includes("/")) - Number(b.file.includes("/")));

// headings outside of code blocks, with the ids given by the heading anchors plugin on the joined docs
const slugger = new GithubSlugger();
const escapeHtml = (text: string) => text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const headings: { text: string; slug: string; depth: number }[] = [];
// per file, the id of each heading in the file alone mapped to its id on this page
const anchors = new Map<string, Map<string, string>>();
for (const doc of docs) {
    const file_slugger = new GithubSlugger();
    const file_anchors = new Map<string, string>();
    for (const [, hashes, heading] of doc.content
        .replace(/^ *(```|~~~)[\s\S]*?^ *\1/gm, "")
        .matchAll(/^(#{1,6})[ \t]+(.*)$/gm)) {
        const text = heading.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1").trim();
        const slug = slugger.slug(text.replace(/`/g, ""));
        file_anchors.set(file_slugger.slug(text.replace(/`/g, "")), slug);
        headings.push({ text: escapeHtml(text).replace(/`([^`]+)`/g, "<code>$1</code>"), slug, depth: hashes.length });
    }
    anchors.set(doc.file, file_anchors);
}

// point links to the other docs to their section on this page, and other relative links to GitHub
const md_content = docs
    .map((doc) =>
        doc.content.replace(/\]\((?!https?:|#|mailto:)([^)\s]+)\)/g, (match, link) => {
            const url = new URL(link, docs_blob_url + doc.file);
            const target = docs.find((d) => docs_blob_url + d.file === url.origin + url.pathname)?.file;
            if (!target) {
                return `](${url.href})`;
            }
            const file_anchors = anchors.get(target)!;
            const anchor = url.hash ? file_anchors.get(url.hash.slice(1)) : file_anchors.values().next().value;
            return `](#${anchor ?? url.hash.slice(1)})`;
        }),
    )
    .join("\n\n");
---

<MarkdownTocLayout
    title={title}
    subtitle={subtitle}
    headings={headings}
    md_github_url={`${repo_url}/tree/main/docs`}
    leftSidebar={false}
>
    <Markdown of={md_content} />
</MarkdownTocLayout>
