---
import MarkdownTocLayout from "@layouts/MarkdownTocLayout.astro";
import { markdown } from "@mashehu/astropub-md";
import { fetchNfCoreUtilsDocs, joinNfCoreUtilsDocs, resolveNfCoreUtilsHtml } from "@utils/nf-core-utils";

const title = "nf-core-utils";
const subtitle = "Nextflow plugin with nf-core utility functions";

const docs = await fetchNfCoreUtilsDocs();
// rendered here rather than with <Markdown>, to read the ids of the headings for the links and the table of contents
const { html, headings } = resolveNfCoreUtilsHtml(String(await markdown(joinNfCoreUtilsDocs(docs))), docs);
---

<MarkdownTocLayout
    title={title}
    subtitle={subtitle}
    headings={headings}
    md_github_url="https://github.com/nf-core/nf-core-utils/edit/main/docs/NfCoreUtilities.md"
    leftSidebar={false}
>
    <Fragment set:html={html} />
</MarkdownTocLayout>
