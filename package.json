        "@types/node": "^26.6.5",
        "@types/semver": "^7.8.0",
        "hastscript": "^9.0.1",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "prettier-plugin-svelte": "^4.1.1",
        "progress": "^2.0.3",
        "sass-embedded": "^1.106.1",
        "vitest": "^4.1.12"
    },
    "overrides": {
        "satteri-expressive-code": {
            "expressive-code": "$expressive-code"
        }
    },
    "packageManager": "npm@12.2.1"
}
