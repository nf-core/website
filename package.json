{
    "name": "nf-co.re",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "build-cache": "npm run build-pipeline-json && npm run build-component-json",
        "build-pipeline-json": "node bin/pipelines.json.js",
        "build-component-json": "node bin/components.json.js",
        "check-api-catalog": "node bin/check-api-catalog.js",
        "update": "npx npm-check-updates --interactive --format group --workspaces",
        "test-all": "for dir in sites/*; do (cd $dir && npm run test); done",
        "test-unit": "node --test bin/satteri/*.test.ts",
        "bench": "node bench/build.bench.mjs",
        "knip": "knip",
        "lint": "eslint sites bin bench astro.config.base.mjs"
    },
    "workspaces": [
        "sites/*"
    ],
    "dependencies": {
        "@astro-community/astro-embed-youtube": "^0.5.10",
        "@astrojs/markdown-remark": "^7.3.9",
        "@astrojs/markdown-satteri": "^0.4.10",
        "@astrojs/mdx": "^8.1.6",
        "@astrojs/netlify": "^8.2.14",
        "@astrojs/partytown": "^2.1.9",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.5",
        "@astrojs/svelte": "^9.1.6",
        "@aws-sdk/client-s3": "^3.1171.0",
        "@date-fns/tz": "^1.5.0",
        "@docsearch/css": "^5.2.0",
        "@docsearch/js": "^5.2.0",
        "@expressive-code/core": "^0.44.4",
        "@expressive-code/plugin-line-numbers": "^0.44.4",
        "@mashehu/astropub-md": "^3.0.0",
        "@nanostores/persistent": "^1.3.5",
        "@octokit/plugin-retry": "^8.1.1",
        "@octokit/plugin-throttling": "^11.0.5",
        "@rollup/plugin-yaml": "5.0.1",
        "astro": "^7.4.12",
        "astro-expressive-code": "^0.44.4",
        "astro-icon": "^1.2.0",
        "bootstrap": "^5.3.9",
        "bootstrap-print-css": "^1.0.1",
        "date-fns": "^4.4.0",
        "datebook": "^8.0.1",
        "dotenv": "^18.0.10",
        "expressive-code": "^0.44.4",
        "file-icons-js": "github:websemantics/file-icons-js",
        "file-saver": "^2.0.5",
        "fuzzysort": "^4.0.2",
        "hast-util-from-html": "^2.1.0",
        "js-yaml": "^5.5.0",
        "katex": "^0.19.1",
        "leaflet": "^1.9.4",
        "leaflet-fullscreen": "^1.0.2",
        "mermaid": "^12.3.0",
        "nanostores": "^1.5.5",
        "octokit": "^5.0.5",
        "pretty-bytes": "^7.2.0",
        "remark": "^15.0.1",
        "satori": "0.63.2",
        "satori-html": "^0.3.2",
        "satteri": "^0.11.7",
        "satteri-autolink-headings": "^0.3.0",
        "satteri-emoji": "^0.3.0",
        "satteri-expressive-code": "^0.1.32",
        "satteri-katex": "^0.3.0",
        "satteri-slug": "^0.3.0",
        "semver": "^7.8.6",
        "sharp": "^0.35.5",
        "shiki": "^4.6.0",
        "starlight-codeblocks": "^1.5.0",
        "svelte": "^5.58.0",
        "svelte-confetti": "^2.3.2",
        "unist-util-visit": "^5.2.0",
        "yaml": "^2.9.1",
        "youtube-player": "^5.6.0"
    },
    "devDependencies": {
        "@codspeed/tinybench-plugin": "^6.1.1",
        "@j178/prek": "^0.5.11",
        "@playwright/test": "^1.65.1",
        "@types/leaflet": "^1.9.22",
        "@types/node": "^26.6.6",
        "@types/semver": "^7.8.0",
        "eslint": "^10.15.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-svelte": "^3.24.1",
        "hastscript": "^9.0.3",
        "knip": "^6.45.1",
        "prettier": "^3.10.1",
        "prettier-plugin-astro": "^1.1.2",
        "prettier-plugin-svelte": "^4.2.0",
        "progress": "^2.0.3",
        "sass-embedded": "^1.108.2",
        "tinybench": "^6.2.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0"
    },
    "overrides": {
        "satteri-expressive-code": {
            "expressive-code": "$expressive-code"
        }
    },
    "packageManager": "npm@12.2.3"
}
