        "pretty-bytes": "^7.2.0",
        "rehype-highlight": "^7.0.2",
        "remark": "^15.0.1",
        "satori": "0.35.1",
        "satori-html": "^0.3.2",
        "satteri": "^0.10.5",
        "satteri-autolink-headings": "^0.2.0",
        "satteri-emoji": "^0.2.1",
        "satteri-expressive-code": "^0.1.24",
        "satteri-katex": "^0.2.0",
        "satteri-slug": "^0.2.0",
        "semver": "^7.8.5",
        "sharp": "^0.35.5",
